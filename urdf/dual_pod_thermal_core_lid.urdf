<?xml version="1.0"?>
<!-- Dual-Pod Submerged Thermal Core Lid Assembly for a lightweight milk can.
     Dimensions are in metres; the two gel pods are removable in the real product
     but fixed here for stable Gazebo simulation. -->
<robot name="dual_pod_thermal_core_lid">
  <material name="stainless_steel"><color rgba="0.58 0.65 0.67 1"/></material>
  <material name="insulated_hdpe"><color rgba="0.08 0.31 0.43 1"/></material>
  <material name="dark_polymer"><color rgba="0.06 0.08 0.09 1"/></material>
  <material name="gel_blue"><color rgba="0.12 0.58 0.86 0.65"/></material>
  <material name="oled_cyan"><color rgba="0.02 0.72 0.92 1"/></material>

  <link name="milk_can">
    <visual><origin xyz="0 0 0.42"/><geometry><cylinder radius="0.28" length="0.72"/></geometry><material name="stainless_steel"/></visual>
    <collision><origin xyz="0 0 0.42"/><geometry><cylinder radius="0.28" length="0.72"/></geometry></collision>
    <inertial><origin xyz="0 0 0.42"/><mass value="2.5"/><inertia ixx="0.09" ixy="0" ixz="0" iyy="0.09" iyz="0" izz="0.08"/></inertial>
  </link>

  <link name="insulated_lid">
    <visual><geometry><cylinder radius="0.31" length="0.10"/></geometry><material name="insulated_hdpe"/></visual>
    <collision><geometry><cylinder radius="0.31" length="0.10"/></geometry></collision>
  </link>
  <joint name="lid_mount" type="fixed"><parent link="milk_can"/><child link="insulated_lid"/><origin xyz="0 0 0.82"/></joint>

  <link name="sealing_collar">
    <visual><geometry><cylinder radius="0.285" length="0.055"/></geometry><material name="dark_polymer"/></visual>
  </link>
  <joint name="collar_mount" type="fixed"><parent link="insulated_lid"/><child link="sealing_collar"/><origin xyz="0 0 -0.065"/></joint>

  <link name="electronics_housing">
    <visual><geometry><box size="0.25 0.19 0.12"/></geometry><material name="dark_polymer"/></visual>
    <visual name="oled"><origin xyz="0 -0.101 0.017" rpy="1.5708 0 0"/><geometry><box size="0.14 0.008 0.055"/></geometry><material name="oled_cyan"/></visual>
  </link>
  <joint name="electronics_mount" type="fixed"><parent link="insulated_lid"/><child link="electronics_housing"/><origin xyz="0 -0.02 0.135"/></joint>

  <link name="handle">
    <visual name="left_post"><origin xyz="-0.18 0 0"/><geometry><box size="0.045 0.07 0.30"/></geometry><material name="dark_polymer"/></visual>
    <visual name="right_post"><origin xyz="0.18 0 0"/><geometry><box size="0.045 0.07 0.30"/></geometry><material name="dark_polymer"/></visual>
    <visual name="grip"><origin xyz="0 0 0.14"/><geometry><box size="0.40 0.07 0.055"/></geometry><material name="dark_polymer"/></visual>
  </link>
  <joint name="handle_mount" type="fixed"><parent link="insulated_lid"/><child link="handle"/><origin xyz="0 0 0.245"/></joint>

  <link name="left_gel_pod">
    <visual name="ss304_shell"><geometry><cylinder radius="0.052" length="0.48"/></geometry><material name="stainless_steel"/></visual>
    <visual name="frozen_gel_core"><geometry><cylinder radius="0.038" length="0.43"/></geometry><material name="gel_blue"/></visual>
    <collision><geometry><cylinder radius="0.052" length="0.48"/></geometry></collision>
  </link>
  <joint name="left_pod_quick_lock" type="fixed"><parent link="insulated_lid"/><child link="left_gel_pod"/><origin xyz="-0.105 0 -0.355"/></joint>

  <link name="right_gel_pod">
    <visual name="ss304_shell"><geometry><cylinder radius="0.052" length="0.48"/></geometry><material name="stainless_steel"/></visual>
    <visual name="frozen_gel_core"><geometry><cylinder radius="0.038" length="0.43"/></geometry><material name="gel_blue"/></visual>
    <collision><geometry><cylinder radius="0.052" length="0.48"/></geometry></collision>
  </link>
  <joint name="right_pod_quick_lock" type="fixed"><parent link="insulated_lid"/><child link="right_gel_pod"/><origin xyz="0.105 0 -0.355"/></joint>

  <gazebo reference="milk_can"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="insulated_lid"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="left_gel_pod"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="right_gel_pod"><material>Gazebo/Grey</material></gazebo>
</robot>
