        <visual name="worker_07_legs"><pose>21 17 .48 0 0 0</pose><geometry><box><size>.32 .22 .96</size></box></geometry><material><diffuse>.06 .12 .24 1</diffuse></material></visual><visual name="worker_07_vest"><pose>21 17 1.22 0 0 0</pose><geometry><box><size>.48 .28 .52</size></box></geometry><material><diffuse>1 .68 .02 1</diffuse></material></visual><visual name="worker_07_head"><pose>21 17 1.62 0 0 0</pose><geometry><sphere><radius>.17</radius></sphere></geometry><material><diffuse>.68 .44 .27 1</diffuse></material></visual>
