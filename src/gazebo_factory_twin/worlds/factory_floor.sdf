        <visual name="worker_01_legs"><pose>-10 1 .48 0 0 0</pose><geometry><box><size>.32 .22 .96</size></box></geometry><material><diffuse>.06 .12 .24 1</diffuse></material></visual><visual name="worker_01_vest"><pose>-10 1 1.22 0 0 0</pose><geometry><box><size>.48 .28 .52</size></box></geometry><material><diffuse>1 .68 .02 1</diffuse></material></visual><visual name="worker_01_head"><pose>-10 1 1.62 0 0 0</pose><geometry><sphere><radius>.17</radius></sphere></geometry><material><diffuse>.66 .43 .27 1</diffuse></material></visual>
