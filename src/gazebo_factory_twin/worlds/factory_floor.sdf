    <!-- Perimeter security encloses the complete factory and employee parking site. -->
    <model name="site_security_perimeter">
      <static>true</static>
      <link name="perimeter">
        <!-- 2.4 m anti-climb fence rails on all four sides; south side leaves a 9 m controlled-entry gap. -->
        <visual name="north_fence"><pose>0 38 1.2 0 0 0</pose><geometry><box><size>108 .10 2.4</size></box></geometry><material><diffuse>.20 .24 .27 1</diffuse></material><transparency>.32</transparency></visual>
        <visual name="west_fence"><pose>-54 -6 1.2 0 0 0</pose><geometry><box><size>.10 88 2.4</size></box></geometry><material><diffuse>.20 .24 .27 1</diffuse></material><transparency>.32</transparency></visual>
        <visual name="east_fence"><pose>54 -6 1.2 0 0 0</pose><geometry><box><size>.10 88 2.4</size></box></geometry><material><diffuse>.20 .24 .27 1</diffuse></material><transparency>.32</transparency></visual>
        <visual name="south_fence_west"><pose>-27 -50 1.2 0 0 0</pose><geometry><box><size>54 .10 2.4</size></box></geometry><material><diffuse>.20 .24 .27 1</diffuse></material><transparency>.32</transparency></visual>
        <visual name="south_fence_east"><pose>31.5 -50 1.2 0 0 0</pose><geometry><box><size>45 .10 2.4</size></box></geometry><material><diffuse>.20 .24 .27 1</diffuse></material><transparency>.32</transparency></visual>
        <!-- Reinforced posts make the boundary readable in Gazebo even at distance. -->
        <visual name="post_nw"><pose>-54 38 1.5 0 0 0</pose><geometry><box><size>.35 .35 3</size></box></geometry><material><diffuse>.10 .13 .15 1</diffuse></material></visual>
        <visual name="post_ne"><pose>54 38 1.5 0 0 0</pose><geometry><box><size>.35 .35 3</size></box></geometry><material><diffuse>.10 .13 .15 1</diffuse></material></visual>
        <visual name="post_sw"><pose>-54 -50 1.5 0 0 0</pose><geometry><box><size>.35 .35 3</size></box></geometry><material><diffuse>.10 .13 .15 1</diffuse></material></visual>
        <visual name="post_se"><pose>54 -50 1.5 0 0 0</pose><geometry><box><size>.35 .35 3</size></box></geometry><material><diffuse>.10 .13 .15 1</diffuse></material></visual>
        <visual name="camera_nw"><pose>-53.7 37.7 3.05 0 .55 .78</pose><geometry><box><size>.34 .22 .18</size></box></geometry><material><diffuse>.04 .05 .06 1</diffuse></material></visual><visual name="camera_ne"><pose>53.7 37.7 3.05 0 -.55 2.36</pose><geometry><box><size>.34 .22 .18</size></box></geometry><material><diffuse>.04 .05 .06 1</diffuse></material></visual><visual name="camera_sw"><pose>-53.7 -49.7 3.05 0 .55 -.78</pose><geometry><box><size>.34 .22 .18</size></box></geometry><material><diffuse>.04 .05 .06 1</diffuse></material></visual><visual name="camera_se"><pose>53.7 -49.7 3.05 0 -.55 -2.36</pose><geometry><box><size>.34 .22 .18</size></box></geometry><material><diffuse>.04 .05 .06 1</diffuse></material></visual>
        <visual name="security_light_west"><pose>-45 -49.4 4.4 0 0 0</pose><geometry><cylinder><radius>.10</radius><length>6</length></cylinder></geometry><material><diffuse>.18 .20 .22 1</diffuse></material></visual><visual name="security_light_west_lamp"><pose>-45 -49.4 7.25 0 0 0</pose><geometry><sphere><radius>.26</radius></sphere></geometry><material><emissive>.9 .95 1 1</emissive></material></visual>
        <visual name="security_light_east"><pose>45 -49.4 4.4 0 0 0</pose><geometry><cylinder><radius>.10</radius><length>6</length></cylinder></geometry><material><diffuse>.18 .20 .22 1</diffuse></material></visual><visual name="security_light_east_lamp"><pose>45 -49.4 7.25 0 0 0</pose><geometry><sphere><radius>.26</radius></sphere></geometry><material><emissive>.9 .95 1 1</emissive></material></visual>
      </link>
    </model>

    <!-- Main vehicle entrance at the south fence, with a guard booth and RFID barrier. -->
    <model name="main_security_gate">
      <static>true</static>
      <link name="gate">
        <visual name="entry_road"><pose>4.5 -50 .02 0 0 0</pose><geometry><box><size>9 8 .05</size></box></geometry><material><diffuse>.16 .18 .19 1</diffuse></material></visual>
