    <model name="solar_canopy"><static>true</static><pose>8 0 4 0 0 0</pose><link name="link"><visual name="roof"><geometry><box><size>6 5 .15</size></box></geometry><material><diffuse>.05 .12 .22 1</diffuse></material></visual><visual name="post1"><pose>-2.5 -2  -2 0 0 0</pose><geometry><box><size>.2 .2 4</size></box></geometry></visual></link></model>

    <!-- QA display: cutaway lightweight milk can with the Dual-Pod Submerged Thermal Core Lid Assembly. -->
    <model name="dual_pod_thermal_core_lid_assembly">
      <static>true</static>
      <pose>20 -10 0 0 0 0</pose>
      <link name="thermal_lid_and_can">
        <collision name="can_collision"><pose>0 0 .42 0 0 0</pose><geometry><cylinder><radius>.26</radius><length>.72</length></cylinder></geometry></collision>
        <!-- Milk container and a lightly tinted cutaway liquid volume. -->
        <visual name="milk_can_shell"><pose>0 0 .42 0 0 0</pose><geometry><cylinder><radius>.28</radius><length>.72</length></cylinder></geometry><material><diffuse>.38 .42 .43 1</diffuse><specular>.75 .75 .75 1</specular></material></visual>
        <visual name="milk_volume_cutaway"><pose>0 0 .48 0 0 0</pose><geometry><cylinder><radius>.255</radius><length>.59</length></cylinder></geometry><transparency>.68</transparency><material><diffuse>.82 .94 1 .32</diffuse></material></visual>
        <visual name="container_base"><pose>0 0 .075 0 0 0</pose><geometry><cylinder><radius>.285</radius><length>.05</length></cylinder></geometry><material><diffuse>.12 .14 .15 1</diffuse></material></visual>

        <!-- HDPE / PUF insulated lid and airtight sealing collar. -->
        <visual name="insulated_lid"><pose>0 0 .82 0 0 0</pose><geometry><cylinder><radius>.31</radius><length>.10</length></cylinder></geometry><material><diffuse>.08 .31 .43 1</diffuse><specular>.18 .26 .3 1</specular></material></visual>
        <visual name="sealing_collar"><pose>0 0 .755 0 0 0</pose><geometry><cylinder><radius>.285</radius><length>.055</length></cylinder></geometry><material><diffuse>.05 .09 .1 1</diffuse></material></visual>
        <visual name="lid_top_inset"><pose>0 0 .874 0 0 0</pose><geometry><cylinder><radius>.225</radius><length>.012</length></cylinder></geometry><material><diffuse>.12 .42 .55 1</diffuse></material></visual>

        <!-- Waterproof electronics cavity with active OLED status display. -->
        <visual name="electronics_housing"><pose>0 -.02 .955 0 0 0</pose><geometry><box><size>.25 .19 .12</size></box></geometry><material><diffuse>.06 .08 .09 1</diffuse></material></visual>
        <visual name="oled_display"><pose>0 -.121 .972 1.5708 0 0</pose><geometry><box><size>.14 .008 .055</size></box></geometry><material><emissive>.02 .72 .92 1</emissive><diffuse>.02 .15 .19 1</diffuse></material></visual>
        <visual name="status_led"><pose>.09 -.126 1.01 0 0 0</pose><geometry><sphere><radius>.012</radius></sphere></geometry><material><emissive>.05 .95 .28 1</emissive></material></visual>

        <!-- Ergonomic overhead lifting handle, clear of the food-contact rods. -->
        <visual name="handle_left_post"><pose>-.18 0 1.065 0 0 0</pose><geometry><box><size>.045 .07 .30</size></box></geometry><material><diffuse>.06 .08 .09 1</diffuse></material></visual>
        <visual name="handle_right_post"><pose>.18 0 1.065 0 0 0</pose><geometry><box><size>.045 .07 .30</size></box></geometry><material><diffuse>.06 .08 .09 1</diffuse></material></visual>
        <visual name="handle_grip"><pose>0 0 1.205 0 0 0</pose><geometry><box><size>.40 .07 .055</size></box></geometry><material><diffuse>.06 .08 .09 1</diffuse></material></visual>

        <!-- Twin removable SS304 gel pods: thin-wall, vertical and submerged in the milk core. -->
        <visual name="left_pod_cap"><pose>-.105 0 .72 0 0 0</pose><geometry><cylinder><radius>.064</radius><length>.045</length></cylinder></geometry><material><diffuse>.2 .24 .25 1</diffuse><specular>.8 .8 .8 1</specular></material></visual>
        <visual name="right_pod_cap"><pose>.105 0 .72 0 0 0</pose><geometry><cylinder><radius>.064</radius><length>.045</length></cylinder></geometry><material><diffuse>.2 .24 .25 1</diffuse><specular>.8 .8 .8 1</specular></material></visual>
        <visual name="left_ss304_gel_pod"><pose>-.105 0 .465 0 0 0</pose><geometry><cylinder><radius>.052</radius><length>.48</length></cylinder></geometry><material><diffuse>.58 .65 .67 1</diffuse><specular>.9 .9 .9 1</specular></material></visual>
        <visual name="right_ss304_gel_pod"><pose>.105 0 .465 0 0 0</pose><geometry><cylinder><radius>.052</radius><length>.48</length></cylinder></geometry><material><diffuse>.58 .65 .67 1</diffuse><specular>.9 .9 .9 1</specular></material></visual>
        <visual name="left_gel_core"><pose>-.105 -.001 .465 0 0 0</pose><geometry><cylinder><radius>.038</radius><length>.43</length></cylinder></geometry><transparency>.35</transparency><material><diffuse>.12 .58 .86 .65</diffuse><emissive>.01 .08 .12 1</emissive></material></visual>
        <visual name="right_gel_core"><pose>.105 -.001 .465 0 0 0</pose><geometry><cylinder><radius>.038</radius><length>.43</length></cylinder></geometry><transparency>.35</transparency><material><diffuse>.12 .58 .86 .65</diffuse><emissive>.01 .08 .12 1</emissive></material></visual>
      </link>
    </model>

    <!-- Ten active operators distributed across machining, assembly, QA and dispatch. -->
    <model name="factory_workforce">
