        <visual name="car_01"><pose>-36 -42 0.52 0 0 0</pose><geometry><box><size>3.3 1.8 .68</size></box></geometry><material><diffuse>.80 .10 .08 1</diffuse></material></visual><visual name="car_01_cabin"><pose>-36 -42 1.0 0 0 0</pose><geometry><box><size>1.75 1.62 .38</size></box></geometry><material><diffuse>.06 .18 .26 1</diffuse></material></visual>
        <visual name="car_02"><pose>-28 -42 0.52 0 0 0</pose><geometry><box><size>3.3 1.8 .68</size></box></geometry><material><diffuse>.10 .30 .78 1</diffuse></material></visual><visual name="car_02_cabin"><pose>-28 -42 1.0 0 0 0</pose><geometry><box><size>1.75 1.62 .38</size></box></geometry><material><diffuse>.06 .18 .26 1</diffuse></material></visual>
        <visual name="car_03"><pose>-20 -42 0.52 0 0 0</pose><geometry><box><size>3.3 1.8 .68</size></box></geometry><material><diffuse>.12 .56 .24 1</diffuse></material></visual><visual name="car_03_cabin"><pose>-20 -42 1.0 0 0 0</pose><geometry><box><size>1.75 1.62 .38</size></box></geometry><material><diffuse>.06 .18 .26 1</diffuse></material></visual>
        <visual name="car_04"><pose>-12 -42 0.52 0 0 0</pose><geometry><box><size>3.3 1.8 .68</size></box></geometry><material><diffuse>.80 .48 .06 1</diffuse></material></visual><visual name="car_04_cabin"><pose>-12 -42 1.0 0 0 0</pose><geometry><box><size>1.75 1.62 .38</size></box></geometry><material><diffuse>.06 .18 .26 1</diffuse></material></visual>
      </link>
