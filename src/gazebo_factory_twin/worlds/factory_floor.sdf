        <visual name="rfid_reader"><pose>7.6 -45.9 1.0 0 0 0</pose><geometry><box><size>.22 .16 .42</size></box></geometry><material><emissive>.05 .65 .22 1</emissive></material></visual>
        <visual name="gate_camera"><pose>8.7 -49.6 3.15 0 .5 0</pose><geometry><box><size>.38 .24 .20</size></box></geometry><material><diffuse>.03 .04 .05 1</diffuse></material></visual>
        <visual name="security_sign"><pose>4.5 -49.75 3.3 1.5708 0 0</pose><geometry><box><size>3.6 .04 .75</size></box></geometry><material><diffuse>.75 .08 .04 1</diffuse><emissive>.15 .01 .01 1</emissive></material></visual>
